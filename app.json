{
  "expo": {
    "name": "Kard",
    "slug": "kard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kard-icon-dark.png",
    "scheme": "kard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "dark": "./assets/images/kard-icon-dark.png",
        "light": "./assets/images/kard-icon-light.png",
        "tinted": "./assets/images/kard-icon-tinted.png"
      },
      "bundleIdentifier": "com.lino.finances",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lino.finances",
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0C1311",
        "foregroundImage": "./assets/images/kard-adaptive-fg.png",
        "monochromeImage": "./assets/images/kard-adaptive-mono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kard-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1311",
          "image": "./assets/images/kard-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your finances."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
